// ---------- headers ----------
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =====================
// Enum: Approval Status
// Used across User, Company, Job, Institution
// =====================
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// =====================
// Table: admin
// =====================
model Admin {
  adminId Int @id @default(autoincrement()) @map("admin_id")

  address String?   @db.VarChar(255)
  dob     DateTime? @db.Timestamp(6)

  email String @unique @db.VarChar(255)

  firstName String? @map("first_name") @db.VarChar(255)
  lastName  String? @map("last_name") @db.VarChar(255)

  mobileNumber String? @map("mobile_number") @db.VarChar(255)

  passwordHash String @map("password") @db.VarChar(255)

  image Bytes? @map("image")

  profilePic String? @map("profile_pic") @db.VarChar(255)

  @@map("admin")
}

// =====================
// Table: user
// =====================
model User {
  userId Int @id @default(autoincrement()) @map("user_id")

  address        String?  @db.VarChar(255)
  certifications String[] @default([]) @db.Text
  dob            DateTime? @db.Timestamp(6)

  email String @unique @db.VarChar(255)

  firstName String? @map("first_name") @db.VarChar(255)
  lastName  String? @map("last_name") @db.VarChar(255)

  mobile String? @db.VarChar(255)

  olPassCount Int? @map("ol_pass_count")

  bio     String?  @db.VarChar(1000)
  skills  String[] @default([])
  schools String?  @db.VarChar(500)

  passwordHash String @map("password") @db.VarChar(255)

  image      Bytes?  @map("image")
  profilePic String? @map("profile_pic") @db.VarChar(255)

  //  Approval fields
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(1000)
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamp(6)
  reviewedByAdminId Int?         @map("reviewed_by_admin_id")

  applications Application[]
  institutions Institution[]

  @@map("user")
}

// =====================
// Table: company
// =====================
model Company {
  companyId       Int      @id @default(autoincrement()) @map("company_id")
  companyName     String   @map("company_name") @db.VarChar(255)
  email           String   @unique @db.VarChar(255)
  description     String?  @db.VarChar(255)
  address         String?  @db.VarChar(255)
  phone           String?  @db.VarChar(255)
  location        String?  @db.VarChar(255)
  companySize     String?  @db.VarChar(255)
  founded         DateTime? @db.Timestamp(6)
  benefitsAndPerks String? @db.VarChar(255)
  profilePic      String?  @map("profile_pic") @db.VarChar(255)
  industry        String?  @db.VarChar(255)
  passwordHash    String   @map("password") @db.VarChar(255)
  url             String?  @db.VarChar(255)
  subscriptionId  Int?     @map("subscription_id")

  //  Approval fields
  status            ApprovalStatus @default(PENDING)
  rejectionReason   String?        @map("rejection_reason") @db.VarChar(1000)
  reviewedAt        DateTime?      @map("reviewed_at") @db.Timestamp(6)
  reviewedByAdminId Int?           @map("reviewed_by_admin_id")

  jobs Job[]

  @@map("company")
}

// =====================
// Job belongs to Company
// =====================
model Job {
  id             String   @id @default(uuid())
  companyId      Int      @map("company_id")
  jobTitle       String
  jobType        String
  location       String
  salaryRange    String
  jobDescription String

  responsibilities String[] @default([]) @db.Text
  requiredSkills   String[] @default([]) @db.Text
  requirements     String

  deadline DateTime? @db.Timestamp(6)
  jobDate  DateTime  @default(now())

  //  Approval fields
  status            ApprovalStatus @default(PENDING)
  rejectionReason   String?        @map("rejection_reason") @db.VarChar(1000)
  reviewedAt        DateTime?      @map("reviewed_at") @db.Timestamp(6)
  reviewedByAdminId Int?           @map("reviewed_by_admin_id")

  company      Company       @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  applications Application[]

  @@index([companyId])
}

// =====================
// Application belongs to Job + User
// =====================
model Application {
  id          String   @id @default(uuid())
  jobId       String
  userId      Int      @map("user_id")
  cvPath      String?
  status      String   @default("PENDING")
  coverLetter String?
  createdAt   DateTime @default(now())

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [userId], onDelete: Cascade)
  interviews Interview[]

  @@unique([jobId, userId])
}

// =====================
// Interview belongs to Application
// =====================
model Interview {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  interviewDate DateTime @map("interview_date") @db.Timestamp(6)
  interviewType String   @map("interview_type")
  notes         String?  @db.Text
  status        String   @default("SCHEDULED")
  meetingLink   String?  @map("meeting_link") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interview")
}

// =====================
// Institution - Only users can create
// =====================
model Institution {
  id          String   @id @default(uuid())
  userId      Int      @map("user_id")
  name        String   @db.VarChar(255)
  logo        String?  @db.VarChar(255)
  location    String?  @db.VarChar(255)
  description String?  @db.Text
  website     String?  @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(255)
  founded     String?  @db.VarChar(50)
  students    String?  @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  //  Approval fields
  status            ApprovalStatus @default(PENDING)
  rejectionReason   String?        @map("rejection_reason") @db.VarChar(1000)
  reviewedAt        DateTime?      @map("reviewed_at") @db.Timestamp(6)
  reviewedByAdminId Int?           @map("reviewed_by_admin_id")

  user    User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  courses Course[]

  @@index([userId])
  @@map("institution")
}

// =====================
// Course belongs to Institution
// =====================
model Course {
  id            String      @id @default(uuid())
  institutionId String      @map("institution_id")
  name          String      @db.VarChar(255)
  duration      String      @db.VarChar(100)
  startDate     String      @db.VarChar(100)
  price         String      @db.VarChar(100)
  type          String      @db.VarChar(100)
  spots         Int?
  description   String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("course")
}