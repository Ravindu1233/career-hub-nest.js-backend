// ---------- headers ----------
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =====================
// Table: admin
// =====================
model Admin {
  adminId Int @id @default(autoincrement()) @map("admin_id")

  address String?   @db.VarChar(255)
  dob     DateTime? @db.Timestamp(6)

  email String @unique @db.VarChar(255)

  firstName String? @map("first_name") @db.VarChar(255)
  lastName  String? @map("last_name") @db.VarChar(255)

  mobileNumber String? @map("mobile_number") @db.VarChar(255)

  // store hashed password, but keep DB column name "password"
  passwordHash String @map("password") @db.VarChar(255)

  // longblob -> Bytes (Postgres bytea)
  image Bytes? @map("image")

  profilePic String? @map("profile_pic") @db.VarChar(255)

  @@map("admin")
}

// =====================
// Table: user
// =====================
model User {
  userId Int @id @default(autoincrement()) @map("user_id")

  address       String? @db.VarChar(255)
  certifications String[] @default([]) @db.Text // Changed to array of strings for multiple certifications
  dob DateTime? @db.Timestamp(6)

  email String @unique @db.VarChar(255)

  firstName String? @map("first_name") @db.VarChar(255)
  lastName  String? @map("last_name") @db.VarChar(255)

  mobile String? @db.VarChar(255)

  olPassCount Int? @map("ol_pass_count")

  // ✅ NEW FIELDS
  bio     String?  @db.VarChar(1000)
  skills  String[] @default([])   // Postgres text[]
  schools String?  @db.VarChar(500)

  // store hashed password, but keep DB column name "password"
  passwordHash String @map("password") @db.VarChar(255)

  image Bytes? @map("image")

  profilePic String? @map("profile_pic") @db.VarChar(255)

  applications Application[]
  institutions Institution[]

  @@map("user")
}


// =====================
// Table: company  (separate entity, not a Role)
// =====================
model Company {
  companyId     Int      @id @default(autoincrement()) @map("company_id")
  companyName   String   @map("company_name") @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  description   String?  @db.VarChar(255)
  address       String?  @db.VarChar(255)
  phone         String?  @db.VarChar(255)  // Added field for phone
  location      String?  @db.VarChar(255)  // Added field for location
  companySize   String?  @db.VarChar(255)  // Added field for company size
  founded       DateTime? @db.Timestamp(6) // Added field for founding year
  benefitsAndPerks String? @db.VarChar(255) // Added field for benefits & perks
  profilePic    String?  @map("profile_pic") @db.VarChar(255)
  industry      String?  @db.VarChar(255)
  passwordHash  String   @map("password") @db.VarChar(255)
  url           String?  @db.VarChar(255)
  subscriptionId Int?    @map("subscription_id")
  jobs          Job[]

  @@map("company")
}

// =====================
// Job belongs to Company
// =====================
model Job {
  id               String   @id @default(uuid())
  companyId        Int      @map("company_id")
  jobTitle         String
  jobType          String
  location         String
  salaryRange      String
  jobDescription   String

  // ✅ changed from single string to arrays + deadline
  responsibilities String[] @default([]) @db.Text
  requiredSkills   String[] @default([]) @db.Text
  requirements     String   // keep as extra text if you want (optional UI section)

  deadline         DateTime? @db.Timestamp(6)  // ✅ NEW
  jobDate          DateTime  @default(now())

  company          Company   @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  applications     Application[]

  @@index([companyId])
}

// =====================
// Application belongs to Job + User
// =====================
model Application {
  id         String   @id @default(uuid())
  jobId      String
  userId     Int      @map("user_id")
  cvPath     String?
  status     String   @default("PENDING") // ✅ Changed from "APPLIED" to "PENDING"
  coverLetter String?
  createdAt  DateTime @default(now())

  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  interviews Interview[] // ✅ Add this relation

  @@unique([jobId, userId])
}
// =====================
// Interview belongs to Application
// =====================
model Interview {
  id              String   @id @default(uuid())
  applicationId   String   @map("application_id")
  interviewDate   DateTime @map("interview_date") @db.Timestamp(6)
  interviewType   String   @map("interview_type") // video, phone, in-person
  notes           String?  @db.Text
  status          String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  meetingLink     String?  @map("meeting_link") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interview")
}

// =====================
// Institution - Only users can create
// =====================
model Institution {
  id          String   @id @default(uuid())
  userId      Int      @map("user_id") // User who created/manages the institution
  name        String   @db.VarChar(255)
  logo        String?  @db.VarChar(255) // Can store logo URL or initials
  location    String?  @db.VarChar(255)
  description String?  @db.Text
  website     String?  @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(255)
  founded     String?  @db.VarChar(50) // Year as string (e.g., "2018")
  students    String?  @db.VarChar(50) // e.g., "2,500+"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  courses     Course[]

  @@index([userId])
  @@map("institution")
}

// =====================
// Course belongs to Institution
// =====================
model Course {
  id            String      @id @default(uuid())
  institutionId String      @map("institution_id")
  name          String      @db.VarChar(255)
  duration      String      @db.VarChar(100) // e.g., "6 months"
  startDate     String      @db.VarChar(100) // e.g., "Feb 15, 2026"
  price         String      @db.VarChar(100) // e.g., "Free", "$1,000"
  type          String      @db.VarChar(100) // e.g., "Certificate", "Diploma", "Degree"
  spots         Int?        // Available spots
  description   String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("course")
}
