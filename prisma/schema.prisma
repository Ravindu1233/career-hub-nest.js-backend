// ---------- headers ----------
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =====================
// Table: admin
// =====================
model Admin {
  adminId Int @id @default(autoincrement()) @map("admin_id")

  address String?   @db.VarChar(255)
  dob     DateTime? @db.Timestamp(6)

  email String @unique @db.VarChar(255)

  firstName String? @map("first_name") @db.VarChar(255)
  lastName  String? @map("last_name") @db.VarChar(255)

  mobileNumber String? @map("mobile_number") @db.VarChar(255)

  // store hashed password, but keep DB column name "password"
  passwordHash String @map("password") @db.VarChar(255)

  // longblob -> Bytes (Postgres bytea)
  image Bytes? @map("image")

  profilePic String? @map("profile_pic") @db.VarChar(255)

  @@map("admin")
}

// =====================
// Table: user
// =====================
model User {
  userId Int @id @default(autoincrement()) @map("user_id")

  address       String? @db.VarChar(255)
  certification String? @db.VarChar(255)

  dob DateTime? @db.Timestamp(6)

  email String @unique @db.VarChar(255)

  firstName String? @map("first_name") @db.VarChar(255)
  lastName  String? @map("last_name") @db.VarChar(255)

  mobile String? @db.VarChar(255)

  olPassCount Int? @map("ol_pass_count")

  // store hashed password, but keep DB column name "password"
  passwordHash String @map("password") @db.VarChar(255)

  image Bytes? @map("image")

  applications Application[]

  @@map("user")
}

// =====================
// Table: company  (separate entity, not a Role)
// =====================
model Company {
  companyId Int @id @default(autoincrement()) @map("company_id")

  address     String?   @db.VarChar(255)
  companyName String    @map("company_name") @db.VarChar(255)
  date        DateTime? @db.Timestamp(6)

  description String? @db.VarChar(255)
  email       String  @unique @db.VarChar(255)

  // longblob -> Bytes
  image Bytes? @map("image")

  industry String? @db.VarChar(255)
  mobile   String? @db.VarChar(255)

  // store hashed password, but keep DB column name "password"
  passwordHash String @map("password") @db.VarChar(255)

  url            String? @db.VarChar(255)
  subscriptionId Int?    @map("subscription_id")

  jobs Job[]

  @@map("company")
}

// =====================
// Job belongs to Company
// =====================
model Job {
  id String @id @default(uuid())

  companyId      Int      @map("company_id")
  jobTitle       String
  jobDescription String
  qualification  String?
  location       String?
  workingHours   Int?
  olPassRequired Int?
  imagePath      String?
  jobDate        DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  applications Application[]

  @@index([companyId])
}

// =====================
// Application belongs to Job + User
// =====================
model Application {
  id String @id @default(uuid())

  jobId  String
  userId Int    @map("user_id")

  cvPath    String?
  status    String   @default("APPLIED")
  createdAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
}
